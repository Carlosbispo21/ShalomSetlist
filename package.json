  "version": "0.3.3",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --experimental-strip-types --test tests/domain.test.ts tests/permissions.test.mjs tests/festivities-permissions.test.mjs tests/releases.test.ts tests/release-feed.test.mjs",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "test:e2e": "playwright test",
    "release:build": "node scripts/build-release.mjs",
    "release:publish": "node scripts/publish-release.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/core": "^7.4.3",
